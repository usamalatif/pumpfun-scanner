# PumpFun Scanner - Environment Variables
# Copy this file to .env.local and fill in the values

# Base URL for the app (used for API calls in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Pump.fun API endpoint
PUMPFUN_API_URL=https://frontend-api.pump.fun

# Default refresh interval in milliseconds
REFRESH_INTERVAL=30000

# Optional: Database URL for historical data storage
# DATABASE_URL=postgresql://user:password@localhost:5432/pumpfun
